<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Nota" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/nota_warm_beige</item>
        <item name="android:navigationBarColor">@color/nota_warm_beige</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.Nota.Splash" parent="Theme.Nota">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/nota_warm_beige</item>
        <item name="android:navigationBarColor">@color/nota_warm_beige</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
</resources>
